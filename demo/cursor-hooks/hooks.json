{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/guard-prompt.mjs"
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/guard-secrets.mjs",
        "matcher": "Write|Shell"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/record-edit.mjs"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/run-tests.mjs",
        "loop_limit": 1,
        "timeout": 90
      }
    ]
  }
}
